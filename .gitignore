# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
# Distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
.pytest_cache/
htmlcov/
coverage.xml
.coverage

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Virtual environments
venv/
env/
ENV/
.venv/

# Editor directories and files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db

# Python virtual environment markers
*.env

# Encrypted files, secrets, local settings
.env
secrets.json

# Logs and databases
*.log
*.sqlite3

# Compiled Java class files (if any Java tools used)
*.class

# Wheels
*.whl

# Ignore built assets
dist/

# Backup files
*~
*.bak
